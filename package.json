{
  "name": "winclean-analyzer",
  "version": "1.0.0",
  "description": "A premium, modern desktop storage cleaner and task manager for Windows built with Web Technologies (HTML, CSS, Node.js, and Electron).",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "build:icon": "python scripts/generate-icon.py",
    "build:installer": "node scripts/build-installer.js",
    "dist": "electron-builder --dir && node scripts/build-installer.js",
    "dist:portable": "electron-builder --win portable",
    "dist:all": "electron-builder --win dir portable && node scripts/build-installer.js"
  },
  "keywords": [
    "winclean",
    "cleaner",
    "analyzer",
    "windows",
    "electron"
  ],
  "author": "Alberto Ortiz",
  "license": "ISC",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.albertoortiz.winclean-analyzer",
    "productName": "WinClean Analyzer",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.ico"
    },
    "files": [
      "src/**/*",
      "LICENSE",
      "package.json"
    ]
  }
}
